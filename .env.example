# --- Reasoning provider (the specialists + critic) ---
# anthropic (default) or google. The two are independent of retrieval (below).
LLM_PROVIDER=anthropic

# Anthropic (LLM_PROVIDER=anthropic): a Claude Console key. Cheap by design —
# the tiers are Haiku 4.5 (fast: route/diagnose/price/judge) + Sonnet 4.6 (deep:
# architect/critic). A 24-case eval runs for cents.
ANTHROPIC_API_KEY=

# Google (LLM_PROVIDER=google): a Google AI Studio key. Tiers are Flash + Pro.
# Also the ONLY way to enable dense/hybrid retrieval (Anthropic has no embeddings
# API) — see the retrieval note below.
GOOGLE_API_KEY=

# --- Optional: durable HITL + multi-turn persistence ---
# Postgres connection string (Neon / Supabase free tier works).
# When unset, the human gate still pauses a run, but a PENDING approval does NOT
# survive a restart or a fresh serverless invocation. The UI prints which mode is
# active — that degradation is the exact gap this project criticises in
# ephemeral-HITL platforms, so it is surfaced, never hidden.
DATABASE_URL=

# --- Model tiering (env-swappable; one variable each) ---
# Anthropic (note: if you set the DEEP model to Opus 4.7+/Fable, drop temperature
# in lib/llm.ts — those models reject it; Haiku 4.5 / Sonnet 4.6 accept it).
ANTHROPIC_MODEL_FAST=claude-haiku-4-5
ANTHROPIC_MODEL_DEEP=claude-sonnet-4-6
# Google
GEMINI_MODEL_FAST=gemini-2.5-flash
GEMINI_MODEL_DEEP=gemini-2.5-pro

# --- Retrieval (independent of the reasoning provider) ---
# Dense/hybrid retrieval needs an embeddings API, which only Google offers. With
# a GOOGLE_API_KEY set, retrieval is hybrid (BM25 + dense + RRF). Without one
# (e.g. running Anthropic-only), retrieval degrades to BM25-only — a measured,
# supported path (69.2% recall@5). The reasoning provider and the embeddings
# provider are decoupled on purpose.
GEMINI_EMBED_MODEL=gemini-embedding-001

# --- Demo hardening ---
# Per-IP daily triage cap for the public deployment (0 = unlimited).
RATE_LIMIT_PER_DAY=10
