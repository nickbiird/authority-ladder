# --- Required for live triage (the reasoning specialists + critic) ---
# Google AI Studio key (free tier / student credits work).
# Retrieval, the input gate, and the deterministic evals run with NO key —
# only the LLM reasoning steps need this.
GOOGLE_API_KEY=

# --- Optional: durable HITL + multi-turn persistence ---
# Postgres connection string (Neon / Supabase free tier works).
# When unset, the app falls back to in-memory checkpointing: a triage run still
# pauses on the human gate, but a PENDING approval does NOT survive a restart or
# a fresh serverless invocation. The UI prints which mode is active. That
# degradation is the exact gap this project criticises in ephemeral-HITL
# platforms, so it is surfaced, never hidden.
DATABASE_URL=

# --- Model tiering (env-swappable on purpose: model strings are one variable) ---
# Fast tier: supervisor routing, the diagnostician, the economist, the judge.
# Deep tier: the architect (synthesises the defended design) + the critic.
GEMINI_MODEL_FAST=gemini-2.5-flash
GEMINI_MODEL_DEEP=gemini-2.5-pro
GEMINI_EMBED_MODEL=gemini-embedding-001

# --- Demo hardening ---
# Per-IP daily triage cap for the public deployment (0 = unlimited).
RATE_LIMIT_PER_DAY=10
